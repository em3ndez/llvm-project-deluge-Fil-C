@@ -42,11 +55,23 @@
 
     inline sal_Int64 getSomething_cast(void* p)
     {
+        if (!p)
+            return 0;
+        // Register the pointer so its Fil-C capability can be restored later.
+        zexact_ptrtable_encode(getUnoTunnelPtrTable(), p);
         return sal::static_int_cast<sal_Int64>(reinterpret_cast<sal_IntPtr>(p));
     }
 
     template<class T> inline T* getSomething_cast(sal_Int64 n)
     {
+        if (!n)
+            return nullptr;
+        // Restore the Fil-C capability from the zexact_ptrtable.
+        void* ptr = zexact_ptrtable_decode(getUnoTunnelPtrTable(),
+            sal::static_int_cast<__SIZE_TYPE__>(n));
+        if (ptr)
+            return static_cast<T*>(ptr);
+        // Fallback for pointers encoded by code not yet recompiled.
         return reinterpret_cast<T*>(sal::static_int_cast<sal_IntPtr>(n));
     }
 
