+    // Fil-C (Pizlix): The XUnoTunnel pattern encodes C++ pointers as sal_Int64
+    // integers and decodes them later.  On Fil-C, casting a pointer to an
+    // integer and back loses the object capability, producing a pointer with a
+    // null object.  We use zexact_ptrtable to register the pointer's capability
+    // at encode time and restore it at decode time, while keeping the same
+    // integer value (the raw pointer address) for compatibility with code that
+    // bypasses getSomething_cast.
+    // Defined in comphelper/source/misc/servicehelper.cxx so that all shared
+    // libraries share a single zexact_ptrtable instance.
+    zexact_ptrtable* COMPHELPER_DLLPUBLIC getUnoTunnelPtrTable();
+
     // Class incapsulating UIDs used as e.g. tunnel IDs for css::lang::XUnoTunnel,
     // or implementation IDs for css::lang::XTypeProvider
