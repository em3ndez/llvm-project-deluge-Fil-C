+// We use zexact_ptrtable to register the capability at encode time and restore
+// it at decode time.  zexact_ptrtable_encode returns the pointer's raw integer
+// value, so the string ID is identical to what the old code produced.
+VCL_DLLPUBLIC zexact_ptrtable* getWeldPtrTable();
